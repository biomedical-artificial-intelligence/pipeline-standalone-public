# Copy to `.env` and edit for your machine. Every value has a default in
# app/config.py; only override what differs on your system.

# ---- External AlphaFold3 (you install this separately) --------------------
# Python interpreter of YOUR AlphaFold3 environment:
FOLD_PYTHON=/path/to/af3-venv/bin/python
FOLD_SCRIPT=/path/to/alphafold3/run_alphafold.py
FOLD_MODEL_DIR=/path/to/alphafold3/models
FOLD_DB_DIR=/path/to/alphafold3/databases

# ---- ZDOCK toolkit --------------------------------------------------------
# Directory holding the ZDOCK 3.0.2 binaries (zdock, mark_sur, create.pl,
# create_lig, block.pl) plus uniCHARMM and the legacy libg2c.so.0 that mark_sur
# is linked against. ZDOCK is NOT redistributed in this repository — get it from
# https://zlab.umassmed.edu/zdock/ (academic/non-profit use).
# The pipeline auto-adds DOCK_DIR to LD_LIBRARY_PATH. Use an ABSOLUTE path:
# the pipeline runs from app/, so a relative path will NOT resolve.
DOCK_DIR=/abs/path/to/zdock3.0.2
# Override individual binaries only if they live elsewhere:
# DOCK_BIN=/path/to/zdock/zdock
# DOCK_PREP_BIN=/path/to/zdock/mark_sur
# DOCK_CREATE_PL=/path/to/zdock/create.pl
# DOCK_CREATE_LIG_BIN=/path/to/zdock/create_lig
# distance_antibody is the lab's own Fortran helper — build it from
# dock_src/distance_antibody.f (see dock_src/README), then set an ABSOLUTE path.
# REQUIRED: the default looks in DOCK_DIR/distance_antibody, but step 2b builds
# it into dock_src/, so you must point here or the binary won't be found.
DISTANCE_ANTIBODY_BIN=/abs/path/to/repo/dock_src/distance_antibody
# distance (peptide mode 전용) — dock_src/distance.f 에서 빌드. peptide 모드 쓸 때 REQUIRED.
DISTANCE_BIN=/abs/path/to/repo/dock_src/distance

# Scratch space for per-job docking work:
SCRATCH_DIR=/tmp/dock_scratch

# ---- Pipeline I/O ---------------------------------------------------------
# Defaults to the app/ directory inside the clone; override to redirect:
# PIPELINE_BASE=/data/pipeline
# INPUT_DIR=/data/pipeline/input
# OUTPUT_DIR=/data/pipeline/output

# SQLite job database path:
# DB_PATH=pipeline.db
