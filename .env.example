# Copy to `.env` and edit for your machine. Every value has a default in
# app/config.py; only override what differs on your system.

# ---- External AlphaFold3 (you install this separately) --------------------
# Python interpreter of YOUR AlphaFold3 environment:
ALPHAFOLD_PYTHON=/path/to/af3-venv/bin/python
ALPHAFOLD_SCRIPT=/path/to/alphafold3/run_alphafold.py
ALPHAFOLD_MODEL_DIR=/path/to/alphafold3/models
ALPHAFOLD_DB_DIR=/path/to/alphafold3/databases

# ---- ZDOCK toolkit (install ZDOCK 3.0.2 separately) -----------------------
# Directory containing the ZDOCK binaries: zdock, mark_sur, create.pl, create_lig
# (also the default location searched for distance_antibody):
ZDOCK_DIR=/path/to/zdock
# Override individual binaries only if they live elsewhere:
# ZDOCK_BIN=/path/to/zdock/zdock
# MARK_SUR_BIN=/path/to/zdock/mark_sur
# CREATE_PL=/path/to/zdock/create.pl
# CREATE_LIG_BIN=/path/to/zdock/create_lig
# distance_antibody is the lab's own Fortran helper — build it from
# dock_src/distance_antibody.f (see dock_src/README) and point here:
# DISTANCE_ANTIBODY_BIN=/path/to/distance_antibody

# Scratch space for per-job docking work:
SCRATCH_DIR=/tmp/zdock_scratch

# ---- Pipeline I/O ---------------------------------------------------------
# Defaults to the app/ directory inside the clone; override to redirect:
# PIPELINE_BASE=/data/pipeline
# INPUT_DIR=/data/pipeline/input
# OUTPUT_DIR=/data/pipeline/output

# SQLite job database path:
# DB_PATH=pipeline.db
